{
  "name": "city-merchant-applet",
  "version": "1.0.0",
  "private": true,
  "description": "City merchant uni-app",
  "scripts": {
    "dev": "pnpm run dev:h5",
    "dev:h5": "cross-env UNI_INPUT_DIR=./ uni --host",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=./ UNI_PLATFORM=mp-weixin uni -p mp-weixin --host",
    "build": "pnpm run build:h5",
    "build:h5": "cross-env UNI_INPUT_DIR=./ uni build",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=./ UNI_PLATFORM=mp-weixin uni build -p mp-weixin --outDir unpackage/dist/build/mp-weixin",
    "check": "cross-env UNI_INPUT_DIR=./ uni build"
  },
  "dependencies": {
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/shared": "3.5.41",
    "jweixin-module": "^1.6.0",
    "pinia": "2.3.1",
    "validator": "^13.12.0",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/compiler-sfc": "^3.5.20",
    "cross-env": "^7.0.3",
    "sass": "^1.77.8",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=14.18.0",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@11.8.0"
}
