button {
  display: block;
  font-size: 24rpx;
  border-radius: 40rpx;
  line-height: 2.5;
  background-color: #ff4d1a;
  color: #fff;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0) !important;
}
button[type='primary'] {
  height: 100rpx;
  border-radius: 50rpx;
  line-height: 100rpx;
  font-size: 30rpx;
  background-color: #ff4d1a;
  margin: 0 auto;
}
button[type='primary'][plain] {
  background-color: #ff4d1a;
  color: #fff;
}
button[type='default'] {
  border-radius: 0;
  width: 100%;
  height: 100rpx;
  background-color: #ff4d1a;
  font-size: 32rpx;
  color: #fff;
  line-height: 100rpx;
}
button[type='mini'] {
  padding: 0 20rpx;
  border-radius: 53rpx;
  height: 53rpx;
  background-color: #ff4d1a;
  line-height: 53rpx;
  color: #fff;
  font-size: 26rpx;
  margin: 0;
}
button[type='miniA'] {
  padding: 0 20rpx;
  border-radius: 53rpx;
  height: 53rpx;
  background-color: #fff;
  line-height: 53rpx;
  color: #ff4d1a;
  font-size: 26rpx;
  margin: 0;
  border: 1rpx solid #ff4d1a;
}
button.button-hover[type='primary'] {
  background-color: #ff4d1a;
  color: #fff;
}
button.button-hover[type='primary'][plain] {
  background-color: #ff4d1a;
  color: #fff;
}
button.button-hover[type='default'] {
  background-color: #ff4d1a;
  color: #fff;
}
button.button-hover[type='default'][plain] {
  background-color: #ff4d1a;
  color: #fff;
}
