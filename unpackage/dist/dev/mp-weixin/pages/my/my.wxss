view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.btna {
  background: linear-gradient(90deg, #F5AB18 0%, #F55606 100%);
  margin: 20rpx 40rpx;
  font-weight: 600;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 96rpx;
  border-radius: 80rpx;
}
.items {
  margin: 0 40rpx;
  margin-bottom: 32rpx;
  position: relative;
}
.items radio {
  position: absolute;
  right: 0;
  top: 50%;
  -webkit-transform: translateY(-50%) scale(0.8);
          transform: translateY(-50%) scale(0.8);
}
.font1 {
  padding: 40rpx 0;
  text-align: center;
}
.cutsa {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  font-weight: 400;
  font-size: 22rpx;
  color: #FFFFFF;
  padding: 0 12rpx;
}
.container {
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
}
.container .meminfo {
  height: 100rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-bottom: 34rpx;
  flex-wrap: nowrap;
}
.container .meminfo .memit {
  width: calc((100% - 3rpx)/4);
  text-align: center;
}
.container .meminfo .memit > view:first-child {
  font-weight: 400;
  font-size: 20rpx;
  color: #999999;
}
.container .meminfo .memit > view:last-child {
  font-weight: 600;
  font-size: 22rpx;
  color: #222222;
}
.container .meminfo .line {
  width: 1rpx;
  height: 60rpx;
  background: #DDDDDD;
}
.container .titles text {
  font-weight: 400;
  font-size: 24rpx;
  color: #999999;
}
.container .my {
  font-weight: 600;
  font-size: 28rpx;
  color: #F55606;
}
.container scroll-view {
  white-space: nowrap;
}
.container scroll-view .itens {
  line-height: 72rpx;
  display: inline-block;
  background: #F5F5F5;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
  position: relative;
  font-weight: 400;
  font-size: 28rpx;
  color: #222222;
  padding: 0 20rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}
.container scroll-view .on {
  border: 2rpx solid #F55606;
  font-weight: 600;
  font-size: 28rpx;
  color: #F55606;
}
.container scroll-view .on > image {
  position: absolute;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  bottom: -10rpx;
  z-index: 1;
}
.container .defas {
  border-radius: 12rpx;
  height: 104rpx;
  padding: 0 24rpx;
  background: #F5F5F5;
}
.container .rankbg1 {
  background: linear-gradient(90deg, #FFF1D6 0%, #F6F8FC 100%);
}
.container .rankbg2 {
  background: linear-gradient(90deg, #E3EFFC 0%, #F6F8FC 100%);
}
.container .rankbg3 {
  background: linear-gradient(90deg, #FFF0E6 0%, #FFFCFA 100%);
}
.container .ranks {
  width: 58rpx;
  height: 64rpx;
  position: relative;
}
.container .ranks > text {
  font-weight: 400;
  font-size: 32rpx;
  color: #222222;
  position: absolute;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  bottom: 12rpx;
}
.container .ranks > image {
  width: 100%;
  height: 100%;
}
.btns {
  margin: 32rpx;
}
.btns > view {
  height: 100rpx;
  background: #272A33;
  border-radius: 16rpx;
  border: 1rpx solid #FAD5B4;
  width: calc((100% - 16rpx)/2);
  box-sizing: border-box;
}
.btns > view text {
  color: #fff;
  font-weight: 400;
  font-size: 32rpx;
  color: #FFFFFF;
  margin-left: 12rpx;
  margin-right: 6rpx;
}
.members {
  margin: 0 32rpx;
  position: relative;
  z-index: 99;
}
.members > view {
  width: calc((100% - 32rpx)/3);
  background: #272A33;
  border-radius: 16rpx;
  overflow: hidden;
}
.members > view > view:first-child {
  background: #3E465C;
}
.members > view > view:first-child .line {
  border: 1rpx dashed #6F7DA3;
}
.members > view > view:first-child .a-1 > view:first-child {
  font-weight: 400;
  font-size: 24rpx;
  color: #B2B6C2;
  margin-bottom: 8rpx;
}
.members > view > view:first-child .a-1 > view:last-child {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 58rpx;
}
page {
  background: #181A1F;
}
.checkes {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  height: 130rpx;
  text-align: center;
}
.checkes .a-i {
  width: calc((100% - 64rpx - 2rpx)/2);
}
.checkes .a-i > view:last-child {
  font-size: 40rpx;
  color: #523E2E;
  font-weight: bold;
}
.checkes .lines {
  width: 2rpx;
  height: 82rpx;
  background: #F5E0CE;
}
.mans {
  font-weight: 400;
  font-size: 20rpx;
  color: #FFFFFF;
  width: 102rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #2F323D 0%, #1F1F29 100%);
  border-radius: 16rpx;
}
.tops {
  margin: 20rpx 32rpx;
  height: 340rpx;
  position: relative;
  padding: 32rpx;
  box-sizing: border-box;
}
.tops .relative {
  position: relative;
  z-index: 99;
}
.tops .cash {
  position: absolute;
  right: 32rpx;
  top: 78rpx;
  background: linear-gradient(90deg, #F5AB18 0%, #F55606 100%);
  border-radius: 32rpx;
  width: 140rpx;
  height: 64rpx;
  color: #fff;
  font-size: 26rpx;
  z-index: 9999;
}
.tops > image:first-child {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: -1;
}
.tops > image:last-child {
  position: absolute;
  top: 260rpx;
  left: 0;
  width: 100%;
  height: 453rpx;
  z-index: 1;
}

