view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.text-more-2 {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.items {
  height: 84rpx;
  background: linear-gradient(90deg, rgba(18, 81, 185, 0.6) 0%, rgba(30, 100, 200, 0.8) 50%, rgba(0, 0, 0, 0) 100%);
  border-radius: 12rpx 0px 0px 12rpx;
  margin-bottom: 16rpx;
  margin-left: 40rpx;
  box-sizing: border-box;
  padding-right: 20rpx;
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.items > view:nth-child(2) {
  margin-left: 40rpx;
  display: flex;
  align-items: center;
}
.items > view:nth-child(2) > view {
  width: 293rpx;
  font-weight: 400;
  font-size: 24rpx;
  color: #FFFFFF;
}
.items > view:nth-child(2) image {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
}
.items > view {
  font-weight: bold;
  font-size: 24rpx;
  color: #FFFFFF;
}
.items > image {
  width: 42rpx;
  height: 48rpx;
  position: absolute;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  left: -20rpx;
}
view,
text {
  z-index: 8;
}
.part3 {
  margin: 0 38rpx;
  margin-top: 32rpx;
}
.part3 > view:nth-child(2) {
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.part3 > view:nth-child(2) > view:first-child text:first-child {
  margin-right: 20rpx;
}
.part3 > view:nth-child(2) > view:last-child text:first-child {
  margin-right: 77rpx;
}
.part3 > view:nth-child(2) text {
  font-weight: 400;
  font-size: 20rpx;
  color: #00D2E5;
}
.part3 > view:first-child {
  height: 60rpx;
  position: relative;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.part3 > view:first-child > image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.part3 > view:first-child > view:nth-child(2) {
  height: 60rpx;
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFE;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 5;
}
.part3 > view:first-child > view:nth-child(2) image {
  width: 35rpx;
  height: 30rpx;
  margin-right: 8rpx;
}
.part3 > view:first-child > view:last-child {
  height: 60rpx;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 5;
}
.part3 > view:first-child > view:last-child > view {
  font-weight: 400;
  font-size: 20rpx;
  color: rgba(255, 255, 254, 0.8);
  margin-left: 20rpx;
}
.part3 > view:first-child > view:last-child .on {
  color: #fff;
  position: relative;
}
.part3 > view:first-child > view:last-child .on::after {
  content: '';
  width: 48rpx;
  height: 4rpx;
  background: #26EDFF;
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
}
.part1 {
  margin: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.part1 > view {
  width: calc((100% - 6rpx)/2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 96rpx;
  position: relative;
}
.part1 > view > image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.part1 > view view {
  font-weight: 400;
  font-size: 20rpx;
  color: #FFFFFF;
  position: relative;
  z-index: 5;
}
.part {
  margin: 0 16rpx;
  position: relative;
  height: 245rpx;
  padding-top: 7%;
  box-sizing: border-box;
}
.part > image {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}
.part > view {
  display: flex;
  align-items: baseline;
  justify-content: center;
  position: relative;
  z-index: 9;
}
.part > view text {
  font-weight: bold;
  font-size: 56rpx;
  color: #FEFFFF;
}
