view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.btms {
  position: fixed;
  bottom: 0;
  left: 0;
  background: #fff;
  text-align: center;
  width: 100vw;
}
.btms > view {
  margin: 20rpx 40rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #F5AB18 0%, #F55606 100%);
  border-radius: 48rpx;
  font-weight: 600;
  font-size: 32rpx;
  color: #FFFFFF;
}
.inputs {
  align-items: baseline;
  border-bottom: 1rpx solid #DDDDDD;
}
.inputs text:first-child {
  height: 68rpx;
  width: 29rpx;
  font-size: 48rpx;
  margin-right: 20rpx;
}
.inputs input {
  height: 136rpx;
  background: #FFFFFF;
  font-size: 72rpx;
  color: #222222;
  flex: 1;
}
.inputs text:last-child {
  font-weight: 400;
  font-size: 26rpx;
  color: #F55606;
}
.cash {
  padding: 0 32rpx;
  background: #FFF5ED;
  height: 72rpx;
}
.cash view {
  font-weight: 400;
  font-size: 28rpx;
  color: #FE780F;
}
page {
  background: #fff;
}
.nos1 {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
}
.nos1 > view {
  box-sizing: border-box;
  width: 50%;
  position: relative;
}
.nos1 > view > view:first-child {
  font-size: 20rpx;
  color: #999999;
}
.nos1 > view > view:last-child {
  font-weight: 600;
  font-size: 22rpx;
}
.nos1 > view:last-child::before {
  content: "";
  width: 1rpx;
  height: 60rpx;
  background: #DDDDDD;
  position: absolute;
  left: 0;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
}
.nos {
  background: #F5F5F5;
  border-radius: 12rpx;
  font-weight: 400;
  font-size: 22rpx;
  color: #555555;
  text-align: center;
  line-height: 100rpx;
}

