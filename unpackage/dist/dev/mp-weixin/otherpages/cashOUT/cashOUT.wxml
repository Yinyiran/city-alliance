<view><block wx:if="{{!cashInfo||cashInfo.apply_status!=2}}"><view data-event-opts="{{[['tap',[['gopage',['$event']]]]]}}" class="cash acea-row row-middle row-between" bindtap="__e"><view class="acea-row row-middle">当前未绑定提现开户账户，绑定账户后可提现</view><uv-icon vue-id="4dbe7128-1" name="arrow-right" color="#FE780F" bind:__l="__l"></uv-icon></view></block><block wx:if="{{cashInfo&&cashInfo.status!=1}}"><view data-event-opts="{{[['tap',[['gopage',['$event']]]]]}}" class="cash acea-row row-middle row-between" bindtap="__e"><view class="acea-row row-middle">当前未绑定提现开户账户，绑定账户后可提现</view><uv-icon vue-id="4dbe7128-2" name="arrow-right" color="#FE780F" bind:__l="__l"></uv-icon></view></block><view class="m-40"><view class="acea-row row-middle row-between"><view class="font-28">提现到账户</view></view><block wx:if="{{!cashInfo}}"><view class="nos m-t-20">当前未绑定提现开户账户，请前往绑定</view></block><block wx:else><view class="nos1 m-t-20 acea-row row-middle"><view><view>账户账号</view><view>{{cashInfo.card_no}}</view></view><view class="p-l-20"><view>真实姓名</view><view>{{cashInfo.realname}}</view></view></view></block><view class="font-28 m-t-40">提现金额</view><view class="acea-row inputs"><text>￥</text><input type="number" placeholder="请输入" data-event-opts="{{[['input',[['__set_model',['','apply_money','$event',[]]]]]]}}" value="{{apply_money}}" bindinput="__e"/><text data-event-opts="{{[['tap',[['alls',['$event']]]]]}}" bindtap="__e">全部提现</text></view><view class="m-t-20" style="color:#999999;">当前可提现金额<text>{{balance_money+"元"}}</text>{{"，一天最高可提现额度为"+max+"元"}}</view><view class="m-t-56" style="color:#999999;"><rich-text nodes="{{introduction}}"></rich-text></view><view class="btms iphone-x"><view data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">提现</view></view></view></view>