view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.activeTimeB {
  border: 1rpx solid #ff4d19 !important;
  color: #ff4d19 !important;
  font-weight: 600;
}
.activeTime {
  background-color: #ff4d1a !important;
  color: #fff !important;
}
.timeList view {
  width: 190rpx;
  height: 73rpx;
  border-radius: 73rpx;
  background-color: #f6f7fb;
  text-align: center;
  line-height: 73rpx;
  margin-right: 20rpx;
  margin-top: 20rpx;
}
.timeRange {
  width: 267rpx;
  height: 87rpx;
  border-radius: 30rpx;
  background-color: #f6f7fb;
  text-align: center;
  line-height: 87rpx;
}
.popupBox {
  width: 750rpx;
  border-radius: 40rpx 40rpx 0rpx 0rpx;
  background-color: #fff;
}
 .picker-view {
  background-color: #fff !important;
}
.picker-view {
  width: 750rpx;
  height: 300rpx;
  background-color: #fff !important;
  margin-bottom: 30rpx;
}
.picker-view picker-view-column {
  background-color: #f6f7fb !important;
}
.picker-view .item {
  line-height: 100rpx;
  text-align: center;
  font-weight: 600;
  font-size: 28rpx;
}
.itemType {
  width: 152rpx;
  height: 53rpx;
  background-color: #fff;
  border-radius: 10rpx;
  margin-right: 20rpx;
  line-height: 53rpx;
  text-align: center;
}
.active {
  background-color: #ff4d19 !important;
  color: #fff !important;
}

