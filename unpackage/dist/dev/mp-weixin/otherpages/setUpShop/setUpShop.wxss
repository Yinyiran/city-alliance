view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
page {
  background-color: #fff;
}
.successSty {
  width: 108rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: #02D800;
  text-align: center;
  line-height: 44rpx;
  color: #fff;
  margin-left: 20rpx;
}
.certifyItem {
  width: 621rpx;
  height: 198rpx;
  border: 1rpx solid #dddfe4;
  margin: 0 auto;
  border-radius: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}
.certifyItem .icon-weixinzhifu {
  color: #09bb07;
  font-size: 80rpx;
  width: 100rpx;
}
.certifyItem .icon-zhifubao {
  color: #06b4fd;
  font-size: 70rpx;
  width: 100rpx;
}
.UnderReview {
  text-align: center;
}
.UnderReview image {
  text-align: center;
  padding-top: 100rpx;
  width: 112.06rpx;
  height: 141.07rpx;
}
.ApTypeSty {
  padding: 0 20rpx;
}
.ApTypeSty view {
  width: 223rpx;
  height: 89rpx;
  border-radius: 100rpx;
  background-color: #f0f1f4;
  text-align: center;
  line-height: 89rpx;
  color: #1c274c;
  text-align: center;
  font-family: "Alibaba PuHuiTi 2.0";
  font-size: 28rpx;
}
.ApTypeSty .activeB {
  background-color: #ff4d1a !important;
  color: #fff !important;
}
.colorSty {
  color: #ffc9ba;
}
.iptSty {
  width: 600rpx;
  height: 114rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background-color: #f6f7fb;
  margin: 0 auto;
  margin-bottom: 15rpx;
  padding: 0 25rpx;
}
.iptSty input {
  width: 100%;
}
.bodySty {
  width: 750rpx;
  opacity: 1;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: -60rpx;
  padding-top: 50rpx;
  padding-bottom: 30rpx;
}
.stepSty {
  margin-top: 50rpx;
  width: 750rpx;
  height: 240rpx;
  border-radius: 30rpx 30rpx 0 0;
  opacity: 1;
  border: 1rpx solid #ffffff;
  background: #ff9374;
  padding: 0 0rpx;
  padding-right: 20rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}
.stepSty .stepItem {
  width: 166rpx;
}
.stepSty .xuXian {
  width: 30rpx;
  height: 0;
  border-top: 2rpx dashed #ffae9e;
}
.stepSty .xuXianA {
  width: 30rpx;
  height: 0;
  border-top: 2rpx dashed #fff;
}
.setHeadBg {
  height: 405rpx;
  width: 100%;
  padding-top: 50rpx;
  box-sizing: border-box;
  background-image: linear-gradient(to top, #ff9374, #ff9374, #ff4d19);
}

