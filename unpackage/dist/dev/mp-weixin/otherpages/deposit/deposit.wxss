.warn {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 48rpx 32rpx;
  padding: 32rpx 24rpx;
  font-weight: 400;
  font-size: 24rpx;
  color: #F51D1D;
}
.bg4 {
  position: fixed;
  top: 0;
  z-index: -1;
  width: 100vw;
  height: 894rpx;
  top: 0;
}
.mains > image {
  width: 280rpx;
  height: 56rpx;
  margin-top: 44rpx;
  margin-left: 52rpx;
}
.mains > view:nth-child(2) {
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 44rpx;
  margin-top: 24rpx;
  margin-left: 52rpx;
  margin-bottom: 46rpx;
}
.mains > view:nth-child(3) {
  padding: 64rpx 32rpx;
  margin: 0 32rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.mains > view:nth-child(3) > view:nth-child(1) {
  font-weight: 400;
  font-size: 32rpx;
  color: #222222;
}
.mains > view:nth-child(3) > view:nth-child(2) {
  font-size: 104rpx;
  color: #222222;
  font-weight: bold;
}
.mains > view:nth-child(3) .btn {
  background: linear-gradient(90deg, #F5AB18 0%, #F55606 100%);
  border-radius: 48rpx;
  line-height: 96rpx;
  margin-top: 64rpx;
  font-weight: 600;
  font-size: 32rpx;
  color: #FFFFFF;
}

