view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
 .uv-subsection--button__bar {
  background-color: #FFEDE9 !important;
}
.items {
  padding: 24rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
}
.items .t1 {
  font-weight: 400;
  font-size: 20rpx;
  color: #FA7F28;
  background: #FFF5ED;
  border-radius: 4rpx;
  padding: 0 6rpx;
}
.items .t2 {
  text-align: right;
}
.items .t2 > view:first-child {
  font-weight: 600;
  font-size: 30rpx;
  color: #F51D1D;
}
.items .t2 > view:last-child {
  font-weight: 400;
  font-size: 22rpx;
  color: #999999;
}
.mains {
  margin: 20rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}
.mains > view:first-child {
  font-weight: 600;
  font-size: 32rpx;
  color: #1D1E24;
}
.container {
  background: #f5f5f5;
  height: 200rpx;
  border-radius: 24rpx 24rpx 0rpx 0rpx;
  padding: 32rpx;
}
.bg2s {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 550rpx;
  z-index: -1;
}
.part1 {
  padding-top: 20rpx;
  box-sizing: border-box;
  padding-left: 40rpx;
  position: relative;
}
.part1 > view {
  font-weight: 400;
  font-size: 24rpx;
  color: #FFFFFF;
}
.part1 > view:nth-child(2) {
  font-weight: 600;
  font-size: 70rpx;
  color: #FFFFFF;
}
.part1 text {
  font-weight: 600;
  font-size: 24rpx;
  color: #FFFFFF;
}
.fcolor {
  color: #F51D1D;
}

