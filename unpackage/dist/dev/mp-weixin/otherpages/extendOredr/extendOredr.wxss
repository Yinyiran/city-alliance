view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.relative {
  position: relative;
}
.wbg {
  background: #fff;
}
.bg1 {
  background: #F6F7FB;
}
.acea-nowrap {
  flex-wrap: nowrap;
}
.fcolor {
  color: #898FA3;
}
.fcolor1 {
  color: #EC9B28;
}
.fcolor3 {
  color: #777D94;
}
.on {
  font-weight: bold;
  color: #FF4D1A;
}
.on image {
  position: absolute;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  width: 27rpx;
  height: 9rpx;
  bottom: -10rpx;
}
.scrollx {
  background: #F6F7FB;
}
.scrollx view {
  margin-right: 24rpx;
  background: #fff;
  flex: 0 0 calc((100% - 96rpx)/5);
  border-radius: 8rpx;
  text-align: center;
  padding: 6rpx 0;
}
.scrollx .ison {
  background: #FF4D1A;
  color: #fff;
}
.search {
  padding: 15rpx 38rpx;
  background: #FF4D1A;
  color: #fff;
  margin-right: -5rpx;
}
 .uv-search__content__input,
.uv-search__content {
  background: #fff !important;
  height: 83rpx;
}
.info {
  width: calc(100% - 120rpx);
}
.info text {
  padding: 3rpx 13rpx;
  background: #FFF3EF;
  color: #FF4D1A;
}
.goods:first-child {
  margin-top: 0;
}

