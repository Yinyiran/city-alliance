view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.btms {
  position: fixed;
  bottom: 0;
  left: 0;
  background: #fff;
  text-align: center;
  width: 100vw;
  z-index: 99;
}
.btms > view {
  margin: 20rpx 40rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #F5AB18 0%, #F55606 100%);
  border-radius: 48rpx;
  font-weight: 600;
  font-size: 32rpx;
  color: #FFFFFF;
}
radio {
  -webkit-transform: scale(0.7);
          transform: scale(0.7);
}
.container {
  margin: 20rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
}
.container .font {
  font-size: 28rpx;
  color: #222222;
  width: 200rpx;
  white-space: nowrap;
}
.container .getcode {
  font-weight: 400;
  font-size: 32rpx;
  color: #F55606;
}
.part {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 24rpx;
}
.part > view:last-child > view {
  display: inline-block;
  width: calc((100% - 32rpx)/3);
  height: 64rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  margin-top: 24rpx;
  margin-right: 16rpx;
  text-align: center;
  box-sizing: border-box;
  line-height: 64rpx;
  font-weight: 400;
  font-size: 26rpx;
  color: #222200;
}
.part > view:last-child > view:nth-child(3n) {
  margin-right: 0;
}
.part > view:last-child .on {
  border: 1rpx solid #F55606;
  position: relative;
  color: #F55606;
}
.part > view:last-child .on > image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 28rpx;
  height: 28rpx;
}
.bgs {
  width: 100vw;
  height: 556rpx;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}
.bans {
  margin: 12rpx 32rpx 20rpx 32rpx;
}
.bans image {
  width: 100%;
  height: 330rpx;
}

