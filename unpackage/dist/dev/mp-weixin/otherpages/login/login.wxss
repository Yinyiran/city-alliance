@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
@font-face {
  font-family: "iconfont";
  /* Project id 4633945 */
  src: url("//at.alicdn.com/t/c/font_4633945_8c34r6f3c1k.woff2?t=1721980270274") format("woff2"), url("//at.alicdn.com/t/c/font_4633945_8c34r6f3c1k.woff?t=1721980270274") format("woff"), url("//at.alicdn.com/t/c/font_4633945_8c34r6f3c1k.ttf?t=1721980270274") format("truetype");
}
.iconfont {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.icon-zhifubao:before {
  content: "\e607";
}
.icon-h:before {
  content: "\e819";
}
.icon-tianjia:before {
  content: "\e644";
}
.icon-shouji:before {
  content: "\e600";
}
.icon-jingxuan:before {
  content: "\e661";
}
view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
page {
  background-color: #fff;
}
.bodySty {
  width: 750rpx;
  opacity: 1;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: -100rpx;
  padding-top: 50rpx;
  padding-bottom: 30rpx;
}
.iptSty {
  width: 600rpx;
  height: 114rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background-color: #f6f7fb;
  margin: 0 auto;
  margin-bottom: 50rpx;
  padding: 0 25rpx;
}
.iptSty input {
  width: 100%;
}
.headBg {
  padding: 40rpx;
  box-sizing: border-box;
  background-image: url("http://tuanshenghuo.xing-peng.com/mobile/img/A.png");
  background-color: indianred;
  width: 750rpx;
  height: 672rpx;
  background-size: cover;
}
.headBg .headBg_tit {
  position: relative;
  height: 78rpx;
}
.headBg .headBg_tit :nth-child(1) {
  font-family: "Alibaba PuHuiTi 2.0";
  position: absolute;
  bottom: 0;
  font-weight: 600;
  color: #fff;
  z-index: 2;
}
.headBg .headBg_tit :nth-child(2) {
  position: absolute;
  bottom: 10rpx;
  background-color: #ff9900;
  height: 20rpx;
  width: 444rpx;
}

