view {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
text {
  font-family: HarmonyOS Sans SC,PingFangSC-Medium, PingFang SC;
}
.container {
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
}
.container .titles text {
  font-weight: 400;
  font-size: 24rpx;
  color: #999999;
}
.container .my {
  font-weight: 600;
  font-size: 28rpx;
  color: #F55606;
}
.container .defas {
  border-radius: 12rpx;
  height: 104rpx;
  padding: 0 24rpx;
  background: #F5F5F5;
}
.container .rankbg1 {
  background: linear-gradient(90deg, #FFF1D6 0%, #F6F8FC 100%);
}
.container .rankbg2 {
  background: linear-gradient(90deg, #E3EFFC 0%, #F6F8FC 100%);
}
.container .rankbg3 {
  background: linear-gradient(90deg, #FFF0E6 0%, #FFFCFA 100%);
}
.container .ranks {
  width: 58rpx;
  height: 64rpx;
  position: relative;
}
.container .ranks > text {
  font-weight: 400;
  font-size: 32rpx;
  color: #222222;
  position: absolute;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  bottom: 12rpx;
}
.container .ranks > image {
  width: 100%;
  height: 100%;
}
.nums {
  padding: 24rpx 32rpx;
  background: #fff;
  position: relative;
  margin: 32rpx;
  border-radius: 24rpx;
}
.nums > view:first-child {
  font-weight: 400;
  font-size: 24rpx;
  color: #999999;
}
.nums > view:nth-child(2) {
  font-size: 40rpx;
  color: #222222;
  font-weight: bold;
}
.nums > image {
  position: absolute;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  width: 204rpx;
  height: 60rpx;
  right: 32rpx;
}
.search {
  font-weight: 400;
  font-size: 30rpx;
  color: #222222;
  padding: 0 28rpx;
  border-left: #DDDDDD 1rpx solid;
  height: 42rpx;
}

