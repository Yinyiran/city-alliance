# -------------------------------------------------------------
# City Alliance (城盟优选) 全栈环境配置规范
# -------------------------------------------------------------

# 应用运行环境
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# 数据库 (PostgreSQL 17 + PostGIS + pgvector)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=city_alliance
POSTGRES_USER=city_admin
POSTGRES_PASSWORD=city_secret_pass_2026
DATABASE_URL=postgresql://city_admin:city_secret_pass_2026@127.0.0.1:5432/city_alliance

# 分布式缓存与队列 (Redis 7.4)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=city_redis_secret_2026
REDIS_DB=0

# JWT 双 Token 鉴权密钥 (生产环境务必替换为强随机串)
JWT_ACCESS_SECRET=city_alliance_access_token_secret_key_2026_xyz
JWT_REFRESH_SECRET=city_alliance_refresh_token_secret_key_2026_abc
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 微信开放平台 / 小程序配置
WECHAT_CUSTOMER_APP_ID=wx_customer_mock_appid
WECHAT_CUSTOMER_APP_SECRET=wx_customer_mock_secret
WECHAT_MERCHANT_APP_ID=wx_merchant_mock_appid
WECHAT_MERCHANT_APP_SECRET=wx_merchant_mock_secret

# 汇付天下 (Huifu Pay) 支付与分账进件
HUIFU_SYS_ID=huifu_mock_sys_id
HUIFU_PRODUCT_ID=huifu_mock_product_id
HUIFU_RSA_PRIVATE_KEY=huifu_mock_private_key
HUIFU_RSA_PUBLIC_KEY=huifu_mock_public_key

# 云小票打印机 (易联云 / 飞鹅云)
YILIANYUN_USER_ID=yly_mock_user_id
YILIANYUN_API_KEY=yly_mock_api_key
FEIE_USER=feie_mock_user
FEIE_UKEY=feie_mock_ukey

# 阿里云 / 腾讯云 对象存储 (OSS / COS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=city-alliance-assets
OSS_ACCESS_KEY_ID=mock_access_key_id
OSS_ACCESS_KEY_SECRET=mock_access_key_secret
