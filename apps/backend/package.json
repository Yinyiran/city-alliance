{
  "name": "@city-alliance/backend",
  "version": "1.0.0",
  "description": "City Alliance (城盟优选) NestJS 12 + Fastify 5 后端领域服务集群",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/drizzle/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@city-alliance/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^12.3.2",
    "bullmq": "^6.5.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@city-alliance/tsconfig": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/passport-jwt": "^4.0.1",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
