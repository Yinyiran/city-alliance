@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.container {
  width: 100vw;
  min-height: 100vh;
  background-color: #f5f5f5;
}
.poster-wrap {
  padding: 40rpx 0;
  width: calc(100vw - 80rpx);
  margin: 0 40rpx;
  line-height: 1;
}
.poster-wrap image {
  border-radius: 20rpx;
  overflow: hidden;
  width: 100%;
}
.swiper {
  height: 1170rpx;
}
.btn {
  margin: 0 80rpx;
  margin-top: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 80rpx;
  color: #fff;
  text-align: center;
}
.tips {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  font-weight: 600;
  margin-top: 20rpx;
}
.dialog-popup {
  width: 580rpx;
  background: #fff;
  box-sizing: border-box;
  border-radius: 10rpx;
  overflow: hidden;
  height: initial;
}
.dialog-popup .title {
  padding: 30rpx 30rpx 0 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}
.dialog-popup .message {
  padding: 0 30rpx;
  color: #666;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.3;
  margin-top: 30rpx;
}
.dialog-popup .action-wrap {
  margin-top: 50rpx;
  height: 80rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  border-top: 1px solid #eee;
}
.dialog-popup .action-wrap > view {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  text-align: center;
  line-height: 80rpx;
}
.dialog-popup .action-wrap > view:first-child {
  border-right: 1px solid #eee;
  color: #999;
}
.dialog-popup .action-wrap > view button {
  border: none;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  width: 100%;
  height: 100%;
}

