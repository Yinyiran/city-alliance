  box-sizing: border-box;
  background: #ffffff;
  border-radius: 10rpx;
}
.order-detail .order-detail-box .header {
  width: 100%;
  height: 70rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
