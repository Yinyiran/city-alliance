@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.empty {
  width: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  padding: 20rpx;
  box-sizing: border-box;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  padding-top: 80rpx;
}
.empty .empty_img {
  width: 63%;
  height: 450rpx;
}
.empty .empty_img image {
  width: 100%;
  height: 100%;
}
.time {
  text-align: center;
  margin: 10rpx 0;
  color: #7e7e7e;
}
.promotion-list {
  background-color: #FFFFFF;
  height: 200rpx;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  padding: 10rpx 25rpx 40rpx;
  margin-top: 70rpx;
}
.promotion-img {
  width: 140rpx !important;
  height: 140rpx;
}
.promotion-img image {
  width: 140rpx !important;
  height: 100%;
}
.del-none {
  position: absolute;
  top: -50rpx;
  right: 45%;
  border-radius: 10rpx;
  color: #FFFFFF;
  background-color: #000000;
  width: 90rpx;
  height: 50rpx;
  text-align: center;
  z-index: 99;
}
.border-arrow {
  width: 0;
  height: 0;
  font-size: 0;
  line-height: 0;
  position: absolute;
  left: 20rpx;
  top: 44rpx;
}
.border-arrow ._em,
.border-arrow ._ins {
  width: 0;
  height: 0;
  display: block;
  position: absolute;
  border: 8px solid transparent;
  border-style: solid dashed dashed dashed;
  -webkit-transform: rotateX(180deg);
          transform: rotateX(180deg);
}
.border-arrow ._em {
  border-bottom-color: #000000;
}
.border-arrow ._ins {
  border-bottom-color: #000000;
  top: 1px;
}
.site-msg-order {
  padding: 0 30rpx 70rpx;
}
.left-slide-operation-item-view {
  padding: 0 30rpx;
}
.left-slide-operation-item-view .time {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
}
.left-slide-operation-item-view .time text {
  padding: 8rpx 20rpx;
  border-radius: 4rpx;
  display: inline-block;
  line-height: 1;
  background-color: rgba(0, 0, 0, 0.2);
  color: #fff;
  font-size: 24rpx;
}
.left-slide-operation-item-view .flex-row-center {
  width: 100%;
  border-radius: 10rpx;
  overflow: hidden;
}
.order-title {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  line-height: 1;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.order-title text {
  color: red;
  font-size: 36rpx;
  line-height: 28rpx;
}
.order-detail {
  padding: 0 30rpx;
  width: 100%;
  height: 150rpx;
  box-sizing: border-box;
}
.order-img {
  width: 100%;
  height: 210rpx;
  -webkit-flex-shrink: 0;
          flex-shrink: 0;
}
.order-img image {
  width: 100%;
  height: 100%;
}
.order-content {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
}
.order-content view {
  text-overflow: -o-ellipsis-lastline;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  word-break: break-all;
  line-height: 36rpx;
}

