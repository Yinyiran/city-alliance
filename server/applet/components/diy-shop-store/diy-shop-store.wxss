@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.store-list {
  width: 100%;
  max-height: 100vh;
}
.item-box {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  background: #ffffff;
  margin-top: 20rpx;
}
.item-box .item-pic {
  width: 180rpx;
  height: 180rpx;
}
.item-box .item-desc {
  width: calc(100% - 200rpx - 120rpx - 20rpx);
  height: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
}
.item-box .item-desc .desc-info {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  min-height: 75rpx;
}
.item-box .item-desc .desc-info .desc-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-box .item-desc .desc-date {
  font-size: 24rpx;
  color: #909399;
}
.item-box .item-desc .desc-address {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
  color: #909399;
  font-size: 24rpx;
}
.item-box .item-desc .desc-address .icondizhi {
  margin: 0 4rpx 0 2rpx;
  font-size: 26rpx;
}
.item-box .option {
  width: 120rpx;
  height: 200rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  font-size: 24rpx;
}
.item-box .option text {
  line-height: 1;
}
.item-box .option .iconfont {
  font-size: 40rpx;
  margin-bottom: 30rpx;
}
/* 上拉加载区域 */
.no-more {
  width: 100%;
  height: 70rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  color: #909399;
}
.empty-box {
  margin-top: 200rpx;
}

