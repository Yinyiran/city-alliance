@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.container {
  padding-top: 94rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.container .result-image {
  width: 168rpx;
  height: 120rpx;
}
.container .msg {
  font-size: 32rpx;
  margin-top: 66rpx;
  height: 32rpx;
  line-height: 32rpx;
}
.container .pay-amount {
  font-size: 30rpx;
  margin-top: 30rpx;
  font-weight: 600;
  height: 50rpx;
  line-height: 50rpx;
}
.container .pay-amount text {
  font-size: 50rpx;
}
.container .action {
  width: 100%;
  height: 80rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  box-sizing: border-box;
  margin-top: 90rpx;
}
.container .action .btn {
  font-size: 28rpx;
  width: 240rpx;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  border: 1px solid #909399;
  box-sizing: border-box;
}
.container .action .btn:last-child {
  color: #ffffff;
  margin-left: 100rpx;
}

