{
  "name": "@city-alliance/contracts",
  "version": "1.0.0",
  "description": "City Alliance 核心数据契约、领域枚举与 Zod Schema (SSOT)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@city-alliance/tsconfig": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
