@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.address-wrap {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #fff;
  position: relative;
  min-height: 100rpx;
}
.address-wrap .icon {
  position: absolute;
  margin-right: 30rpx;
}
.address-wrap .icon .iconfont {
  line-height: 50rpx;
  font-size: 28rpx;
}
.address-wrap .address-info {
  padding-left: 40rpx;
}
.address-wrap .address-info .info {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.address-wrap .address-info .info text {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
}
.address-wrap .address-info .info text:last-of-type {
  text-align: right;
}
.address-wrap .address-info .detail {
  line-height: 1.3;
  color: #999;
}
.address-wrap .cell-more {
  position: absolute;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  right: 10rpx;
}
.address-wrap .cell-more .iconfont {
  color: #999;
}
.order-item {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #fff;
  position: relative;
}
.order-item .order-body .goods-wrap {
  margin-bottom: 20rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  position: relative;
}
.order-item .order-body .goods-wrap:last-of-type {
  margin-bottom: 0;
}
.order-item .order-body .goods-wrap .goods-img {
  width: 120rpx;
  height: 120rpx;
  padding: 20rpx 0 0;
  margin-right: 20rpx;
}
.order-item .order-body .goods-wrap .goods-img image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}
.order-item .order-body .goods-wrap .goods-info {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  position: relative;
  padding: 20rpx 0 0;
  max-width: calc(100% - 140rpx);
}
.order-item .order-body .goods-wrap .goods-info .goods-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
  font-size: 28rpx;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section {
  width: 100%;
  line-height: 1.3;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section .goods-price {
  font-weight: 700;
  font-size: 15px;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section .unit {
  font-weight: normal;
  font-size: 24rpx;
  margin-right: 2rpx;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section view {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  line-height: 1.3;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section view:last-of-type {
  text-align: right;
}
.order-item .order-body .goods-wrap .goods-info .goods-sub-section view:last-of-type .iconfont {
  line-height: 1;
  font-size: 26rpx;
}
.order-cell {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  margin: 20rpx 0;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  background: #fff;
  line-height: 40rpx;
}
.order-cell .tit {
  text-align: left;
}
.order-cell .box {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  padding: 0 20rpx;
  line-height: inherit;
}
.order-cell .box .textarea {
  height: 40rpx;
}
.order-cell .iconfont {
  color: #bbb;
  font-size: 28rpx;
}
.order-cell .order-pay {
  padding: 0;
}
.order-cell .order-pay text {
  display: inline-block;
  margin-left: 6rpx;
}
.order-summary {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #fff;
  position: relative;
}
.order-summary .order-cell .tit {
  color: #999;
}
.order-summary .order-cell .box {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.order-summary .order-cell .copy {
  font-size: 20rpx;
  display: inline-block;
  color: #666;
  background: #ddd;
  line-height: 1;
  padding: 6rpx 10rpx;
  margin-left: 10rpx;
  border-radius: 18rpx;
}
.order-summary .hr {
  width: calc(100% - 190rpx);
  margin-left: 190rpx;
  height: 1px;
  background: #f7f7f7;
}

