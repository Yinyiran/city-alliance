 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
.team-cate {
  padding: 0 30rpx;
  width: calc(100%);
  height: 90rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  box-sizing: border-box;
  background: #ffffff;
  position: fixed;
  left: 0;
  top: 0px;
}
.team-cate .cate-li {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  line-height: 90rpx;
  height: 100%;
  font-size: 30rpx;
}
.team-cate .cate-li.active {
  box-sizing: border-box;
  border-bottom: 4rpx solid;
}
.team-member {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  color: #909399;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.team-li {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: #fff;
  margin-bottom: 10px;
  border-radius: 10rpx;
}
.team-li .li-box {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
}
.team-li .li-box image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
}
.team-li .li-box .menber-info {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  padding-left: 20rpx;
  box-sizing: border-box;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
}
.team-li .li-box .menber-info .member-name {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  font-size: 28rpx;
}
.team-li .li-box .menber-info .member-name .left {
  width: 70%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.team-li .li-box .menber-info .member-name .left .name {
  max-width: calc(100% - 150rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-li .li-box .menber-info .member-name .left .title {
  padding: 4rpx 16rpx;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  text-align: center;
  font-size: 20rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
  line-height: 1;
  border: 1px solid;
  color: #fff;
}
.team-li .li-box .menber-info .member-date {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  margin-top: 20rpx;
}
.team-li .li-box .menber-info .member-date view {
  width: 50%;
  height: 100%;
  text-align: left;
  line-height: 1;
}
.team-li .li-box .menber-info .member-date view text {
  font-size: 24rpx;
  color: #909399;
}
.team-li .li-box .menber-info .member-date view .tit {
  color: #909399;
}
.team-li .li-box.active {
  border: none;
}

