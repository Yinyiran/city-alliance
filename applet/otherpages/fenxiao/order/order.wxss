}
.withdraw-cate {
  width: 100%;
  height: 90rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  box-sizing: border-box;
  background: #ffffff;
}
.withdraw-cate .cate-li {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.withdraw-cate .cate-li .li-con {
  display: inline-block;
  line-height: 90rpx;
  height: 100%;
  font-size: 30rpx;
}
.withdraw-cate .cate-li .li-con.active {
