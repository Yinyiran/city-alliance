view {
  line-height: 1.8;
  font-family: 'PingFang SC', 'Roboto Medium';
  font-size: 28rpx;
  color: #303133;
}
page {
  background-color: #f8f8f8;
}
.color-base-text {
  color: #ff4544 !important;
}
.color-base-bg {
  background-color: #ff4544 !important;
}
.color-join-cart {
  background-color: #ffb644 !important;
}
.color-base-bg-light {
  background-color: #fff7f7 !important;
}
.color-base-bg-colour {
  background-color: rgba(255, 69, 68, 0.2) !important;
}
.color-base-text-before::after, .color-base-text-before::before {
  color: #ff4544 !important;
}
.color-base-bg-before::after, .color-base-bg-before::before {
  background: #ff4544 !important;
}
.color-base-border {
  border-color: #ff4544 !important;
}
.color-base-border-top {
  border-top-color: #ff4544 !important;
}
.color-base-border-bottom {
  border-bottom-color: #ff4544 !important;
}
.color-base-border-right {
  border-right-color: #ff4544 !important;
}
.color-base-border-left {
  border-left-color: #ff4544 !important;
}
button {
  margin: 0 30rpx;
  font-size: 28rpx;
  border-radius: 20px;
  line-height: 2.7;
}
button[type='primary'] {
  background-color: #ff4544;
}
button[type='primary'][plain] {
  background-color: transparent;
  color: #ff4544;
  border-color: #ff4544;
}
button[type='default'] {
  background: #fff;
  border: 1px solid #eeeeee;
  color: #303133;
}
button[size='mini'] {
  margin: 0 !important;
  line-height: 2.3;
  font-size: 24rpx;
}
button[size='mini'][type='default'] {
  background-color: #fff;
}
button.button-hover[type='primary'] {
  background-color: #ff4544;
}
button.button-hover[type='primary'][plain] {
  background-color: #f8f8f8;
}
button[disabled], button.disabled {
  background: #eeeeee !important;
  color: rgba(0, 0, 0, 0.3) !important;
  border-color: #eeeeee !important;
}
uni-checkbox .uni-checkbox-input.uni-checkbox-input-checked {
  color: #ff4544 !important;
}
uni-switch .uni-switch-input.uni-switch-input-checked {
  background-color: #ff4544 !important;
  border-color: #ff4544 !important;
}
uni-switch .uni-switch-input {
  width: 96rpx !important;
  height: 56rpx !important;
}
uni-switch .uni-switch-input:after, uni-switch .uni-switch-input:before {
  height: 52rpx !important;
}
uni-switch .uni-switch-input:before {
  width: 92rpx !important;
}
uni-switch .uni-switch-input:after {
  width: 52rpx !important;
}
uni-radio .uni-radio-input-checked {
  background-color: #ff4544 !important;
  border-color: #ff4544 !important;
}
uni-slider .uni-slider-track {
  background-color: #ff4544 !important;
}
.uni-tag--primary {
  color: #fff !important;
  background-color: #ff4544 !important;
  border-color: #ff4544 !important;
}
.uni-tag--primary.uni-tag--inverted {
  color: #ff4544 !important;
  background-color: #fff !important;
  border-color: #ff4544 !important;
}
