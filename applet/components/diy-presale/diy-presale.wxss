@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
 .uni-scroll-view ::-webkit-scrollbar {
  /* 隐藏滚动条，但依旧具备可以滚动的功能 */
  display: none;
  width: 0;
  height: 0;
  color: transparent;
  background: transparent;
}
 ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
  background: transparent;
}
scroll-view ::-webkit-scrollbar {
  width: 0;
  height: 0;
  background-color: transparent;
}
.diy-presale .marketing-wrap {
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
}
.diy-presale .marketing-wrap > image {
  width: 100%;
  position: absolute;
  top: 0;
  z-index: 1;
}
.diy-presale .marketing-wrap .marketimg-box {
  padding: 30rpx 0;
  position: relative;
  z-index: 2;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  height: 32rpx;
  line-height: 32rpx;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  padding: 0 30rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-left {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  line-height: 32rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-left image {
  width: 128rpx;
  height: 31rpx;
  margin-right: 20rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-left text {
  color: #909399;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right text {
  font-size: 24rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right.red text {
  background: -webkit-linear-gradient(145deg, #ff5151 0%, #ff7b91 100%);
  background: linear-gradient(-55deg, #ff5151 0%, #ff7b91 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right.blue text {
  background: -webkit-linear-gradient(145deg, #0ecfd3 0%, #12d0ae 100%);
  background: linear-gradient(-55deg, #0ecfd3 0%, #12d0ae 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right.yellow text {
  background: -webkit-linear-gradient(145deg, #feb632 0%, #fe6232 100%);
  background: linear-gradient(-55deg, #feb632 0%, #fe6232 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title .marketimg-box-title-right.violet text {
  background: -webkit-linear-gradient(145deg, #627bfd 0%, #8662fd 100%);
  background: linear-gradient(-55deg, #627bfd 0%, #8662fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title-2 {
  height: 74rpx;
  padding-bottom: 10rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title-2 .marketimg-box-title-left image {
  width: 245rpx;
  height: 73rpx;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title-2 .marketimg-box-title-right {
  font-size: 24rpx;
  color: #909399;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title-3 {
  height: 74rpx;
  padding-bottom: 10rpx;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
          justify-content: center;
}
.diy-presale .marketing-wrap .marketimg-box .marketimg-box-title-3 .marketimg-box-title-left image {
  width: 348rpx;
  height: 74rpx;
}
.diy-presale .marketing-wrap .marketimg-box-2, .diy-presale .marketing-wrap .marketimg-box-3 {
  padding: 40rpx 0;
}
.diy-presale .marketing-wrap .marketimg-box-con {
  width: 100%;
  margin-top: 30rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-scroll {
  width: calc(100% - 30rpx);
  margin: 0 10rpx 0 20rpx;
  line-height: 1;
  white-space: nowrap;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item {
  display: inline-block;
  width: 33.3333%;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item.marketimg-box-con-item_two {
  width: calc((100% - 40rpx) / 3);
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .wrap {
  margin: 0 20rpx 0 10rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .img-box {
  width: 188rpx;
  height: 188rpx;
  text-align: center;
  margin: auto;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item image {
  width: 188rpx;
  height: 188rpx;
  border-radius: 10rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .content .title {
  font-size: 28rpx;
  line-height: 28rpx;
  margin-top: 20rpx;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .content .price-box {
  font-size: 24rpx;
  font-weight: 600;
  height: 32rpx;
  line-height: 32rpx;
  margin-top: 20rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .content .price-box text {
  font-size: 32rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-box-con-item .content .num {
  display: inline-block;
  width: 84rpx;
  height: 34rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  margin-top: 20rpx;
  background-color: rgba(255, 69, 68, 0.06);
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-swiper {
  width: 100%;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-swiper .swiper-item {
  padding: 0 30rpx;
  box-sizing: border-box;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-swiper .marketimg-box-con-item {
  margin-right: 20rpx;
}
.diy-presale .marketing-wrap .marketimg-box-con .marketimg-swiper .marketimg-box-con-item:nth-child(3n + 3) {
  margin-right: 0;
}

