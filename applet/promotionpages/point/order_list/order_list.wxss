@charset "UTF-8";
/**
 * 你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 * 建议使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 */
 .fixed {
  position: relative;
  top: 0;
}
 .empty {
  padding-top: 0 !important;
}
.cart-empty {
  padding-top: 154px !important;
}
.order-container {
  width: 100vw;
  height: 100vh;
}
.align-right {
  text-align: right;
}
.order-item {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  line-height: 1;
  margin-top: 18rpx;
  background-color: #fff;
}
.order-item .order-header {
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  position: relative;
  font-size: 28rpx;
  border-bottom: 1px solid #e3e3e3;
  padding-bottom: 20rpx;
}
.order-item .order-header > view {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
}
.order-item .order-header > view.status {
  font-weight: 500;
}
.order-item .order-body {
  width: 100%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  -webkit-box-align: center;
  -webkit-align-items: center;
          align-items: center;
  padding: 30rpx 0 0;
  box-sizing: border-box;
}
.order-item .order-body image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 5rpx;
  -webkit-align-self: flex-start;
          align-self: flex-start;
  margin-top: 10rpx;
}
.order-item .order-body .goods-name {
  width: 60%;
  display: -webkit-box;
  display: -webkit-flex;
  display: flex;
  font-weight: 500;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  margin-left: 20rpx;
  line-height: 1.2;
}
.order-item .order-body .goods-name .name {
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}
.order-item .order-body .goods-name .guig {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 13rpx;
  color: #838383;
}
.order-item .order-body .goods-name .num {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 13rpx;
}
.order-item .order-body .goods-name .num text {
  font-size: 20rpx;
  color: #909399;
  line-height: 1;
}
.order-item .order-body .goods-total {
  -webkit-box-flex: 1;
  -webkit-flex: 1;
          flex: 1;
  font-size: 24rpx;
  color: #000;
  font-weight: 500;
  text-align: right;
}
.order-item .order-footer {
  text-align: right;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1px solid #f1f1f1;
}
.order-item .order-footer .order-opection {
  display: inline-block;
}
.order-item .order-footer .order-opection .order-box-btn {
  width: 100rpx;
  height: 44rpx;
  line-height: 40rpx;
  padding: 0;
  text-align: center;
}
.empty {
  padding-top: 200rpx;
  text-align: center;
}
.empty .empty-image {
  width: 180rpx;
  height: 180rpx;
}

